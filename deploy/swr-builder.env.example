# 复制为 /opt/swr-builder/swr-builder.env 并 chmod 600
SWR_USERNAME=ndc302-region-1_his_beta@<AK>
SWR_PASSWORD=<长期有效登录密钥>
# 或者只配置 AK/SK（平台自动计算登录密钥）
# SWR_PROJECT=ndc302-region-1_his_beta
# SWR_AK=<AK>
# SWR_SK=<SK>

# 数据库：PostgreSQL 或 PG 兼容模式的 GaussDB；口令单独放在这里，不写进 config.yaml
# BUILDER_DATABASE_URL=postgresql://swr@127.0.0.1:5432/swr
BUILDER_DATABASE_PASSWORD=<数据库口令>
# GaussDB 使用 SHA256 认证时改用华为驱动：BUILDER_DATABASE_DRIVER=gaussdb

# 可选：仅首次创建 admin 时生效，不设置则在 data/admin-initial-password.txt 生成初始密码
# BUILDER_ADMIN_PASSWORD=<至少包含字母数字的强密码>
# 可选：外部托管加密主密钥（足够长的随机值），设置后必须安全备份；不要随意更换
# BUILDER_SECRET_KEY=<稳定的高强度随机值>
# HCS_PASSWORD=<IAM 密码>
# HCS_TOKEN=<IAM Token>
# HCS_IAM_ENDPOINT=https://<现场 IAM Endpoint>

# HCS 专用 AK/SK（与 SWR 认证分开）
# HCS_AK=<AK>
# HCS_SK=<SK>
# HCS_PROJECT_ID=<项目ID>
# HCS_DOMAIN_ID=<账号ID，仅 domain 模式>
# HCS_SECURITY_TOKEN=<临时AK/SK才需要>
