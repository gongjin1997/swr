#!/bin/sh
# 部署管理入口，例如：
#   swrctl status | start | stop [--with-db] | restart | logs [--db] [--tail N] | verify
#   swrctl apply <部署目录内的补丁包> [--db-backup-confirmed]
#   swrctl rollback [版本] | backup | backups | restore <备份目录> | history
#   swrctl build-patch <版本> [--sql <目录>] [--no-code] [--base <版本>] [--description <说明>]
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
IMAGE=$(cat "$ROOT/runtime-image")
case "$IMAGE" in sha256:*) ;; *) echo 'runtime-image 格式错误' >&2; exit 1;; esac
# 挂载路径与宿主机一致，控制器向宿主机 Docker 传入的路径才不会偏移；
# 工作目录沿用当前目录，在部署目录内执行时可以写相对路径（例如 cd /data/swr/updates 后 ../swrctl apply <文件>）。
exec docker run --rm -i --platform linux/arm64 --network none \
  --mount "type=bind,src=$ROOT,dst=$ROOT" \
  --mount type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock \
  --workdir "$PWD" \
  --entrypoint python "$IMAGE" "$ROOT/ops/manage.py" --root "$ROOT" "$@"
