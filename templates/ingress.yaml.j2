# ingress.yaml.j2 - Ingress 对象模板

apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ values.name }}
  namespace: {{ values.namespace }}
  labels:
    app: {{ values.app }}
    project: {{ values.labels.project }}
    environment: {{ values.labels.environment }}
    managed-by: {{ values.labels['managed-by'] }}
  annotations:
    {% for key, value in values.ingress.annotations.items() %}
    {{ key }}: "{{ value }}"
    {% endfor %}
spec:
  ingressClassName: {{ values.ingress.className }}
  {% if values.ingress.tls is defined %}
  tls:
  {% for tls in values.ingress.tls %}
  - secretName: {{ tls.secretName }}
    hosts:
    {% for host in tls.hosts %}
    - {{ host }}
    {% endfor %}
  {% endfor %}
  {% endif %}
  rules:
  {% for host in values.ingress.hosts %}
  - host: {{ host.host }}
    http:
      paths:
      {% for path in host.paths %}
      - path: {{ path.path }}
        pathType: {{ path.pathType }}
        backend:
          service:
            name: {{ values.name }}
            port:
              name: {{ values.service.ports[0].name }}
      {% endfor %}
  {% endfor %}
