# networkpolicy.yaml.j2 - NetworkPolicy 对象模板
# 网络隔离策略

{% if values.networkPolicy is defined and values.networkPolicy.enabled %}
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ values.name }}
  namespace: {{ values.namespace }}
  labels:
    app: {{ values.app }}
    project: {{ values.labels.project }}
    environment: {{ values.labels.environment }}
    managed-by: {{ values.labels['managed-by'] }}
spec:
  podSelector:
    matchLabels:
      app: {{ values.app }}
  policyTypes:
  {% if values.networkPolicy.ingress is defined %}
  - Ingress
  {% endif %}
  {% if values.networkPolicy.egress is defined %}
  - Egress
  {% endif %}

  {% if values.networkPolicy.ingress is defined %}
  ingress:
  {% for rule in values.networkPolicy.ingress %}
  - {% if rule.from is defined %}
    from:
    {% for source in rule.from %}
    - {% if source.podSelector is defined %}
      podSelector:
        matchLabels:
          {% for key, value in source.podSelector.matchLabels.items() %}
          {{ key }}: {{ value }}
          {% endfor %}
      {% endif %}
      {% if source.namespaceSelector is defined %}
      namespaceSelector:
        matchLabels:
          {% for key, value in source.namespaceSelector.matchLabels.items() %}
          {{ key }}: {{ value }}
          {% endfor %}
      {% endif %}
      {% if source.ipBlock is defined %}
      ipBlock:
        cidr: {{ source.ipBlock.cidr }}
        {% if source.ipBlock.except is defined %}
        except:
        {% for ip in source.ipBlock.except %}
        - {{ ip }}
        {% endfor %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% endif %}
    {% if rule.ports is defined %}
    ports:
    {% for port in rule.ports %}
    - protocol: {{ port.protocol }}
      port: {{ port.port }}
    {% endfor %}
    {% endif %}
  {% endfor %}
  {% endif %}

  {% if values.networkPolicy.egress is defined %}
  egress:
  {% for rule in values.networkPolicy.egress %}
  - {% if rule.to is defined %}
    to:
    {% for dest in rule.to %}
    - {% if dest.podSelector is defined %}
      podSelector:
        matchLabels:
          {% for key, value in dest.podSelector.matchLabels.items() %}
          {{ key }}: {{ value }}
          {% endfor %}
      {% endif %}
      {% if dest.namespaceSelector is defined %}
      namespaceSelector:
        matchLabels:
          {% for key, value in dest.namespaceSelector.matchLabels.items() %}
          {{ key }}: {{ value }}
          {% endfor %}
      {% endif %}
      {% if dest.ipBlock is defined %}
      ipBlock:
        cidr: {{ dest.ipBlock.cidr }}
        {% if dest.ipBlock.except is defined %}
        except:
        {% for ip in dest.ipBlock.except %}
        - {{ ip }}
        {% endfor %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% endif %}
    {% if rule.ports is defined %}
    ports:
    {% for port in rule.ports %}
    - protocol: {{ port.protocol }}
      port: {{ port.port }}
    {% endfor %}
    {% endif %}
  {% endfor %}
  {% endif %}
{% endif %}
